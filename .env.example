# Copiar este archivo a .env antes del primer arranque:
#
#   cp .env.example .env
#
# Todas las variables sin valor por defecto son obligatorias: docker
# compose las sustituye en docker-compose.yml y sin ellas los servicios
# no arrancan.

# PostgreSQL. Estas tres credenciales configuran el contenedor y a la vez
# construyen el DATABASE_URL que usan la API y el worker.
POSTGRES_DB=okf
POSTGRES_USER=okf
POSTGRES_PASSWORD=okf

# RabbitMQ. Configuran el broker y el RABBITMQ_URL de API y worker.
# También son las credenciales de la consola de management (puerto 15672).
RABBITMQ_USER=okf
RABBITMQ_PASSWORD=okf

# MinIO. El usuario root es también la access key que usan API y worker.
MINIO_ROOT_USER=okfadmin
MINIO_ROOT_PASSWORD=okfpassword

# Conexión a MinIO desde dentro de la red de Docker.
MINIO_ENDPOINT=minio:9000
MINIO_USE_SSL=false
MINIO_BUCKET=okf

# Clave de firma de los JWT. Cambiarla invalida los tokens ya emitidos.
JWT_SECRET=secret-for-local-development

# Inyección de fallo del worker. Solo se usa para demostrar el caso
# "bundle incompleto" de la rúbrica: drop-index, drop-log o
# empty-concept. Dejarla vacía para el funcionamiento normal.
OKF_FAULT_INJECTION=

# Retardo artificial del worker. Solo se usa para demostrar la
# asincronía efectiva, p. ej. 20s. Debe ser menor que el lease de 5
# minutos. Dejarla vacía para el funcionamiento normal.
OKF_PROCESSING_DELAY=
