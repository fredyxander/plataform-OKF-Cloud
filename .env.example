POSTGRES_DB=okf
POSTGRES_USER=okf
POSTGRES_PASSWORD=okf

RABBITMQ_USER=okf
RABBITMQ_PASSWORD=okf

MINIO_ROOT_USER=okfadmin
MINIO_ROOT_PASSWORD=okfpassword

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=okfadmin
MINIO_SECRET_KEY=okfpassword
MINIO_USE_SSL=false
MINIO_BUCKET=okf

JWT_SECRET=secret-for-local-development

# Inyección de fallo del worker. Solo se usa para demostrar el caso
# "bundle incompleto" de la rúbrica: drop-index, drop-log o
# empty-concept. Dejarla vacía para el funcionamiento normal.
OKF_FAULT_INJECTION=

# Retardo artificial del worker. Solo se usa para demostrar la
# asincronía efectiva, p. ej. 20s. Debe ser menor que el lease de 5
# minutos. Dejarla vacía para el funcionamiento normal.
OKF_PROCESSING_DELAY=
